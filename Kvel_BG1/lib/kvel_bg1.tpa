COPY ~%MOD_FOLDER%/cre/C0Kvel.cre~ ~override~
  SAY NAME1 ~克维尔~
  SAY NAME2 ~克维尔~
  SAY BIO ~有人问起他的过往，克维尔只说他有三件事需要你知道——第一，他生在卓尔之城埃林德林；第二，他已不再属于那里；第三，他如今是个佣兵剑客，在地表靠任何必要的手段谋生。除此之外，你能看出的一切，都只能靠观察。
  
虽说本职是个剑客，克维尔对奥术与偷盗之术也略知一二，那更像是从阅历里学来的，而非钻研所得。你幼时读过关于卓尔的记载，而这位卓尔佣兵虽疏离自恃，却似乎少了族人身上多半的残忍与傲慢，凡事都以冷静、算计的清醒去应对，仿佛没有什么真能完全出乎他的意料。~
  SAY INITIAL_MEETING ~嗯？~ [C0KV000]
  SAY MORALE ~不值当！~ [C0KV001]
  SAY LEADER ~跟我来。~ [C0KV002]
  SAY TIRED ~该歇一歇了。~ [C0KV003]
  SAY BORED ~*叹气*~ [C0KV004]
  SAY BATTLE_CRY1 ~放倒他们！~ [C0KV005]
  SAY BATTLE_CRY2 ~走！~ [C0KV006]
  SAY BATTLE_CRY3 ~~ [C0KV007]
  SAY DAMAGE ~~ [C0KV008]
  SAY DYING ~~ [C0KV009]
  SAY HURT ~我在流血。~ [C0KV010]
  SAY SELECT_COMMON1 ~嗯？~ [C0KV000]
  SAY SELECT_COMMON2 ~怎么？~ [C0KV011]
  SAY SELECT_COMMON3 ~啊？~ [C0KV012]
  SAY SELECT_ACTION1 ~好。~ [C0KV013]
  SAY SELECT_ACTION2 ~行。~ [C0KV014]
  SAY SELECT_ACTION3 ~嗯哼。~ [C0KV015]
  SAY SELECT_ACTION4 ~别这样。~ [C0KV016]
  SAY CRITICAL_HIT ~打中了！~ [C0KV017]
  SAY CRITICAL_MISS ~~ [C0KV018]
  SAY TARGET_IMMUNE ~不成。~ [C0KV019]
  SAY INVENTORY_FULL ~现在动不了。~ [C0KV020]
  SAY SPELL_DISRUPTED ~这不该发生。~ [C0KV021]
  SAY HIDDEN_IN_SHADOWS ~保持安静。~ [C0KV022]
  SAY REACT_TO_DIE_GENERAL ~放倒一个！~ [C0KV023]
  SAY PICKED_POCKET ~发现了什么。~ [C0KV024]
  WRITE_ASCII SCRIPT_OVERRIDE ~C0Kvel~ #8  //override script
  WRITE_ASCII DEATHVAR ~C0Kvel~ #32  //DV
  WRITE_ASCII DIALOG ~C0Kvel~ #8   //pre-joining dialogue file
  WRITE_ASCII SCRIPT_GENERAL ~WTARSGT~ #8   //pre-joining dialogue file
  WRITE_ASCII SCRIPT_DEFAULT ~BDMAGE01~ #8   //pre-joining dialogue file
  WRITE_ASCII PORTRAIT_SMALL ~C0KvelH~ #8   //small portrait
  WRITE_ASCII PORTRAIT_LARGE ~C0KvelH~ #8   //medium portrait

APPEND ~pdialog.2da~ ~C0Kvel C0KvelP C0KvelJ C0KvelD~
  UNLESS ~C0Kvel~

APPEND ~interdia.2da~ ~C0Kvel BC0Kvel~
  UNLESS ~C0Kvel~
  
