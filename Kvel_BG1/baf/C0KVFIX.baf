        SetPlayerSound(Myself,~放倒他们！~ [C0KV005],BATTLE_CRY1) 
        SetPlayerSound(Myself,~走！~ [C0KV006],BATTLE_CRY2) 
        SetPlayerSound(Myself,~~ [C0KV007],BATTLE_CRY3)      
        SetPlayerSound(Myself,~~ [C0KV008],DAMAGE)
        SetPlayerSound(Myself,~~ [C0KV009],DYING)
        SetPlayerSound(Myself,~我在流血。~ [C0KV010],HURT)
        SetPlayerSound(Myself,~嗯？~ [C0KV000],SELECT_COMMON1)
        SetPlayerSound(Myself,~怎么？~ [C0KV011],SELECT_COMMON2)
