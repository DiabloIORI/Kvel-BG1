	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelGlint1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Glint",~才不是！我在看。就现在。仔仔细细。两只眼睛都用上。在扫危险。盯着呢……~)
