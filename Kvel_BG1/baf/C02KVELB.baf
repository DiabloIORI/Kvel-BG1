// BAELOTH

IF
	Global("C02KvelBaeloth1","MYAREA",50)
	Global("C02KvelBaeloth1_50","MYAREA",0)
	CheckStatGT(Player1,40,LORE)
THEN
	RESPONSE #100
		SetGlobal("C02KvelBaeloth1","MYAREA",51)
		SetGlobal("C02KvelBaeloth1_50","MYAREA",1)
END

IF
	Global("C02KvelBaeloth1","MYAREA",50)
	Global("C02KvelBaeloth1_50","MYAREA",0)
	!CheckStatGT(Player1,40,LORE)
THEN
	RESPONSE #100
		SetGlobal("C02KvelBaeloth1","MYAREA",52)
		SetGlobal("C02KvelBaeloth1_50","MYAREA",1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02KvelBaeloth1","MYAREA",0)
	Switch("C02KvelBaeloth1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Baeloth",~这“太阳”实在难以忍受。站到我前面来，用你粗蛮的身架把它挡住。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelBaeloth1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Kvel",~术士，你当我就比你更爱对着这光么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelBaeloth1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Baeloth",~你在这泥土之上的可憎地界待得更久，我推想如此，理所当然。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelBaeloth1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Kvel",~不管怎样，你能正面迎它。也许你会像我一样，渐渐习惯。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelBaeloth1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Baeloth",~不不不！我绝无意在这界里久居成常。当我的走动遮阳伞，我坚持！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelBaeloth1","MYAREA",50)
RESPONSE #51
	DisplayStringHead("C0Kvel",~……“Z'hind lueth elghr”。（“去死吧。”）~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelBaeloth1","MYAREA",60)
RESPONSE #52
	DisplayStringHead("C0Kvel",~……“Z'hind lueth elghr”。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelBaeloth1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Baeloth",~好，我就自己蜷在你身子后头，只要这样能免我这份苦。……别动了，该死的！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelBaeloth1","MYAREA",-1)
END

// CORWIN

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02KvelCorwin1","MYAREA",0)
	Switch("C02KvelCorwin1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Corwin",~卓尔，与大公们签契约，你能得着什么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Kvel",~在人类的权贵中养些善意，是谨慎之举。你另有猜疑？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Corwin",~我难以轻信卓尔，尤其不信任佣兵。一个卓尔佣兵，我该怎么想？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Kvel",~你如何想并不打紧。我的剑就在此处，与你并肩而战。你若接受不了，那副担子就由你自己扛。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Corwin",~好。这一战里有强手相助，我没什么可抱怨的，管他什么肤色。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin1","MYAREA",-1)
END

IF
	Global("C02KvelCorwin2","MYAREA",80)
	Global("C02KvelCorwin2_80","MYAREA",0)
	InParty("VICONIA")
	!InParty("BAELOTH")
THEN
	RESPONSE #100
		SetGlobal("C02KvelCorwin2","MYAREA",81)
		SetGlobal("C02KvelCorwin2_80","MYAREA",1)
END

IF
	Global("C02KvelCorwin2","MYAREA",80)
	Global("C02KvelCorwin2_80","MYAREA",0)
	InParty("VICONIA")
	InParty("BAELOTH")
THEN
	RESPONSE #100
		SetGlobal("C02KvelCorwin2","MYAREA",83)
		SetGlobal("C02KvelCorwin2_80","MYAREA",1)
END

IF
	Global("C02KvelCorwin2","MYAREA",80)
	Global("C02KvelCorwin2_80","MYAREA",0)
	!InParty("VICONIA")
THEN
	RESPONSE #100
		SetGlobal("C02KvelCorwin2","MYAREA",-1)
		SetGlobal("C02KvelCorwin2_80","MYAREA",1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02KvelCorwin2","MYAREA",0)
	Switch("C02KvelCorwin2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Kvel",~队长，你吃得不多。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Corwin",~这话听着像指控。信不信由你，与你做的饭无关。只是我操练养成的习惯。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Kvel",~别的兵看来受的管束没那么严。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("Corwin",~是，他们似乎很爱吃你做的饭。爱到你要走时，说不定还会舍不得。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Kvel",~很好。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Corwin",~等等。你就是这个打算？要博得这些兵的信任？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Kvel",~这有什么不妥？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Corwin",~不。恰恰相反，这很好……前提是仅此而已。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",80)
RESPONSE #81
	DisplayStringHead("Corwin",~你和那个莎尔信徒很不一样。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",87)
RESPONSE #83
	DisplayStringHead("Corwin",~你和那个莎尔信徒很不一样。那个……大嗓门的法师就更不必说了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",85)
RESPONSE #85
	DisplayStringHead("Baeloth",~哼！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",87)
RESPONSE #87
	DisplayStringHead("C0Kvel",~她索取多，给予少。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",89)
RESPONSE #89
	DisplayStringHead("Viconia",~要辱我，就当面来，jaluk。这般背后嚼舌，实在可鄙。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelCorwin2","MYAREA",-1)
END

// DORN

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02KvelDorn1","MYAREA",0)
	Switch("C02KvelDorn1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Dorn",~你打得不错，卓尔。可那股凶悍呢？那嗜杀的血气呢？用这般温吞的招法，你断然享受不到屠戮之乐。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Kvel",~享受屠戮于我有何用？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Dorn",~自然是知道你强过被你碾碎之人的那股激奋；是知道每杀一个，便少一人威胁你性命的那份畅快。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Kvel",~这种转眼即逝的感觉，我无用。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Dorn",~转眼即逝？你小看了杀戮之举留下的余力。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Kvel",~死了便是死了。我没糊涂到以为杀得够多就能不死。我会死。你也会死。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Dorn",~我不惧死。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Kvel",~我们这短暂时光里的意义，你若弃之不顾，便是愚人。你或可夺去许多性命，可你自己的已空虚无值。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02KvelDorn2","MYAREA",0)
	Switch("C02KvelDorn2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Kvel",~被一个黑暗的目的缚得这样紧，还自认是自由人，岂不荒谬。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Dorn",~我主赐我恩惠，供我索求杀戮与征服。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Kvel",~他很快就会收紧缰绳。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("Dorn",~那到了时候，我便把它斩断。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Kvel",~这话荒谬得几乎叫我笑出来。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDorn2","MYAREA",-1)
END

// DYNAHEIR

IF
	Global("C02KvelDynaheir1","MYAREA",2)
	Global("C02KvelDynaheir1_2","MYAREA",0)
	InParty("VICONIA")
THEN
	RESPONSE #100
		SetGlobal("C02KvelDynaheir1","MYAREA",3)
		SetGlobal("C02KvelDynaheir1_2","MYAREA",1)
END

IF
	Global("C02KvelDynaheir1","MYAREA",2)
	Global("C02KvelDynaheir1_2","MYAREA",0)
	!InParty("VICONIA")
THEN
	RESPONSE #100
		SetGlobal("C02KvelDynaheir1","MYAREA",10)
		SetGlobal("C02KvelDynaheir1_2","MYAREA",1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02KvelDynaheir1","MYAREA",0)
	Switch("C02KvelDynaheir1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Dynaheir",~你当真相信，有朝一日卓尔会挣脱罗丝的镣铐，重拾他们昔日的光明？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir1","MYAREA",2)
RESPONSE #3
	DisplayStringHead("Viconia",~这女巫说的是疯话。别告诉我你要顺着她胡思乱想，jaluk。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir1","MYAREA",5)
RESPONSE #5
	DisplayStringHead("Dynaheir",~我没问你，维康妮亚。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Kvel",~盼望与相信是两个大不相同的念头，女巫。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Dynaheir",~那么你也是盼着的？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Kvel",~这问题荒谬。我难道不愿像别的地表种族那样过活，不必受迫害与恐惧？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Kvel",~我几乎不必回答。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Dynaheir",~那会极难，却非不可能。纵使你一人，也仍能带来改变。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Kvel",~那……远远超出我这一世。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Dynaheir",~你寿数绵长。一点改变，总好过没有。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir1","MYAREA",80)
RESPONSE #80
	DisplayStringHead("C0Kvel",~你不如去对我地底那些仍在自相残杀的族人说这话——只要他们没先杀了你。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02KvelDynaheir2","MYAREA",0)
	Switch("C02KvelDynaheir2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Kvel",~你的护卫，那个狂战士……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Dynaheir",~但愿你不是要讥笑他。明斯克受的讥笑已经够多了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Kvel",~不。纯然不疑的忠诚是稀罕之物。你有一份可贵的礼物。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("Dynaheir",~这……是夸赞。只是我希望，假以时日，你能不只把他看作如此。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDynaheir2","MYAREA",-1)
END

// EDWIN

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02KvelEdwin1","MYAREA",0)
	Switch("C02KvelEdwin1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Edwin",~卓尔，你摆弄奥术，就像一个孩子把乐器当玩意儿耍。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Kvel",~魔法是工具。我只取它方便可用的那部分。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Edwin",~这般无知地对待奥术，总有一天会因误用而送命——除非你的傲慢先要了你的命。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Kvel",~怪了。这话我原也可以对着你说。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Edwin",~这正是我如此厌恶与不如我者交谈的缘由。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02KvelEdwin2","MYAREA",0)
	Switch("C02KvelEdwin2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Edwin",~卓尔，等我们这桩乏味的猴戏做完，你看自己有什么前程？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Kvel",~谁知道。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Edwin",~塞尔会欢迎你。我们不以出身这类蠢念头评人，只看本事。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Kvel",~当个奴仆。纵无镣铐，我也会有个奴仆的用处。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Edwin",~带着目的受缚，好过无意义地自由漂泊。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Kvel",~可你的族人偏给你披上红袍，末了却把你打发到这他们看不见的地方，做一桩无谓的差事。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Edwin",~我收回那番厚道的劝告。你在那里活不过一天。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelEdwin2","MYAREA",-1)
END

// GLINT

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02KvelGlint1","MYAREA",0)
	Switch("C02KvelGlint1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Glint",~克维尔！看上头那朵云。是不是有点像深蝙蝠？还有那儿，看！小心，是钩怪！不，等等，那只是一棵扭曲的树。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelGlint1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Kvel",~……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelGlint1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Glint",~唉，得了。你不能日夜都盯着地面。这对你没好处。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelGlint1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Kvel",~侧面与上方的威胁我能听见。地上的危险只能看见。~)
