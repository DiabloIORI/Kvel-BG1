RESPONSE #40
	DisplayStringHead("C0Kvel",~我也见过同样多。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDrake1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Drake",~有人拥抱杀戮，接纳心中的怪物。有人则在绝望里丢了自己，连爱与生都不再带来慰藉。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDrake1","MYAREA",60)	
RESPONSE #60
	DisplayStringHead("C0Kvel",~祭司，你觉得我是哪一种？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDrake1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Drake",~这我还没弄明白。我以为各种兵都见过，你却总让我摸不透。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDrake1","MYAREA",80)
RESPONSE #80
	DisplayStringHead("C0Drake",~我相信你懂得生的可贵，可死亡来临时，你又甘愿交出自己。为什么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDrake1","MYAREA",90)
RESPONSE #90
	DisplayStringHead("C0Kvel",~与不可避之事相争，没有意义。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDrake1","MYAREA",100)
RESPONSE #100
	DisplayStringHead("C0Drake",~啊。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelDrake1","MYAREA",-1)
END

// AURA

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	!PartyHasItem("C0AKOKO")
	GlobalGT("C02KvelAura1","MYAREA",0)
THEN
	RESPONSE #100
	SetGlobal("C02KvelAura1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	PartyHasItem("C0AKOKO")
	GlobalGT("C02KvelAura1","MYAREA",0)
	Switch("C02KvelAura1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Aura",~*喵* [CAT01]~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Aura",~可可酱？你不想要这个？这可是你最喜欢的……好吧，至少昨晚是！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Kvel",~来。这条小鱼该能代替你的干粮。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Aura",~小心，克维尔，它见生人就嘶——~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Aura",~*呼噜* [CAT02]~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Aura",~哇！我从没见它这么快就跟人亲近！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Kvel",~我……有练过。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Aura",~你没看起来那么吓人，克维尔。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02KvelAura2","MYAREA",0)
	Switch("C02KvelAura2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Aura",~克维尔，我们得谈谈。要紧事。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Kvel",~我不认为我做过什么冒犯你或你操守的事。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Aura",~不，我不是要训你。我只是……昨晚听见你的声音醒了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Kvel",~……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Aura",~装哑没用。我知道你在咳血！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Kvel",~一点小毛病。我的身子有人仔细照料。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Aura",~“小毛病”不会让你咳出那种病态的紫色血！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Kvel",~说重点。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",80)
RESPONSE #80
	DisplayStringHead("C0Aura",~我想帮你。可我得知道哪里出了错，才能帮。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",90)
RESPONSE #90
	DisplayStringHead("C0Kvel",~那不可能。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",100)
RESPONSE #100
	DisplayStringHead("C0Aura",~不可能也无妨！我……我知道身边的人病倒、死去是什么滋味。我再也不想看到那样。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",110)
RESPONSE #110
	DisplayStringHead("C0Kvel",~你不必为此操心。我死时会独自一人，本该如此。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",120)
RESPONSE #120
	DisplayStringHead("C0Aura",~克维尔！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",120)
RESPONSE #130
	DisplayStringHead("C0Kvel",~够了。这话我不想再听。把你的本事用在还有指望的人身上。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02KvelAura2","MYAREA",-1)
END

IF
  !GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
THEN
  RESPONSE #100
    SetAreaScript("",GENERAL)
END