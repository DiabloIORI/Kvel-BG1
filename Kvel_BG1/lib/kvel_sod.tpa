COPY ~%MOD_FOLDER%/cre/C02Kvel.cre~ ~override~
  SAY NAME1 ~克维尔~
  SAY NAME2 ~克维尔~
  WRITE_ASCII 0x248 ~C02Kvel~ #8  //override script
  WRITE_ASCII 0x280 ~C0Kvel~ #32  //DV
  WRITE_ASCII 0x2cc ~C02Kvel~ #8   //pre-joining dialogue file
  WRITE_ASCII 0x34 ~C0KvelM~ #8   //small portrait
  WRITE_ASCII 0x3c ~C0KvelL~ #8   //medium portrait
  SAY BIO ~问起他的过去，克维尔告诉你，关于他你只需知道三件事——第一，他生在卓尔城埃林德林；第二，他不再属于那里；第三，他如今是个雇佣剑客，在地表靠一切能用的法子过活。你还能看出什么，只能靠观察。
  
他虽以剑客为业，对奥术与盗术却也有些浅识，看着更像从阅历里学来，而非读书所得。你幼时读过关于卓尔的书，而这卓尔雇佣兵虽疏离自恃，却似乎少有他同族该有的残忍与傲慢，面对一切情形都带着冷静、算计的警觉，仿佛从没有什么全然出乎他的预料。
  
作为一个寻自保之法的投机者，克维尔与大公们签了一纸雇佣剑客的契约，献上效力去对抗圣战军，也借此得些自由，免遭对卓尔那通常的猜疑，虽说他并不指望这能长久，也相信你的队伍是另一样保命的法子。~
  SAY INITIAL_MEETING ~嗯？~ [C0KV000]
  SAY MORALE ~不值当！~ [C0KV001]
  SAY LEADER ~跟我来。~ [C0KV002]
  SAY TIRED ~该歇一歇了。~ [C0KV003]
  SAY BORED ~*叹气*~ [C0KV004]
  SAY BATTLE_CRY1 ~放倒他们！~ [C0KV005]
  SAY BATTLE_CRY2 ~走！~ [C0KV006]
  SAY BATTLE_CRY3 ~~ [C0KV007]
  SAY DAMAGE ~~ [C0KV008]
  SAY DYING ~~ [C0KV009]
  SAY HURT ~我在流血。~ [C0KV010]
  SAY SELECT_COMMON1 ~嗯？~ [C0KV000]
  SAY SELECT_COMMON2 ~怎么？~ [C0KV011]
  SAY SELECT_COMMON3 ~啊？~ [C0KV012]
  SAY SELECT_ACTION1 ~好。~ [C0KV013]
  SAY SELECT_ACTION2 ~行。~ [C0KV014]
  SAY SELECT_ACTION3 ~嗯哼。~ [C0KV015]
  SAY SELECT_ACTION4 ~别这样。~ [C0KV016]
  SAY CRITICAL_HIT ~打中了！~ [C0KV017]
  SAY CRITICAL_MISS ~~ [C0KV018]
  SAY TARGET_IMMUNE ~不成。~ [C0KV019]
  SAY INVENTORY_FULL ~现在动不了。~ [C0KV020]
  SAY SPELL_DISRUPTED ~这不该发生。~ [C0KV021]
  SAY HIDDEN_IN_SHADOWS ~保持安静。~ [C0KV022]
  SAY REACT_TO_DIE_GENERAL ~放倒一个！~ [C0KV023]
  SAY PICKED_POCKET ~发现了什么。~ [C0KV024]
  
APPEND ~bddialog.2da~
~C0Kvel        C02Kvel	C02KvelJ	C02KvelD~
UNLESS ~C0Kvel~

